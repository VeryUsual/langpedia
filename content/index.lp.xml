    <css>
    #langpedia {
        animation: growrotate 1.5s ease-in-out infinite alternate;
        color: lightblue;
    }

    @keyframes growrotate {
        from {
            transform: scale(1) rotate(-4deg);
        }
        to {
            transform: scale(1.1) rotate(10deg);
        }
    }

    body {
        overflow-x: hidden;
    }
